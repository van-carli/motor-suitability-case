<mxfile host="app.diagrams.net">
  <diagram id="motor-suitability" name="Motor de Suitability">
    <mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="880" pageHeight="2020" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="A" value="Motor de Validação de Suitability (Case I)" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=none;dashed=1;strokeColor=#999999;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fontStyle=1;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="60" y="60" width="760" height="1340" as="geometry" />
        </mxCell>
        <mxCell id="B" value="Sistema de ordens: consome a saída do motor (Pergunta 1 do relatório)" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=none;dashed=1;strokeColor=#999999;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fontStyle=1;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="60" y="1440" width="760" height="520" as="geometry" />
        </mxCell>
        <mxCell id="start" value="Nova ordem de compra" style="ellipse;whiteSpace=wrap;html=1;fillColor=#333333;strokeColor=#333333;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="300" y="100" width="200" height="50" as="geometry" />
        </mxCell>
        <mxCell id="inp" value="&lt;b&gt;Entradas&lt;/b&gt;&lt;br&gt;Perfil (score_max_risco)&lt;br&gt;Carteira atual&lt;br&gt;Nova ordem" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="260" y="180" width="280" height="80" as="geometry" />
        </mxCell>
        <mxCell id="d1" value="Entradas válidas?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="310" y="290" width="180" height="100" as="geometry" />
        </mxCell>
        <mxCell id="err" value="Retornar erro de validação&lt;br&gt;(sem decisão de suitability)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="590" y="310" width="180" height="60" as="geometry" />
        </mxCell>
        <mxCell id="d2" value="Carteira atual vazia?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="310" y="420" width="180" height="100" as="geometry" />
        </mxCell>
        <mxCell id="na" value="RC não se aplica&lt;br&gt;(cliente sem posição)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="590" y="440" width="180" height="60" as="geometry" />
        </mxCell>
        <mxCell id="rc" value="&lt;b&gt;Calcular Risco Atual&lt;/b&gt;&lt;br&gt;RC = Σ(risco&lt;sub&gt;i&lt;/sub&gt; × valor&lt;sub&gt;i&lt;/sub&gt;) / Σ valor&lt;sub&gt;i&lt;/sub&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="250" y="550" width="300" height="60" as="geometry" />
        </mxCell>
        <mxCell id="rp" value="&lt;b&gt;Calcular Risco Projetado&lt;/b&gt;&lt;br&gt;RP = (Σ risco&lt;sub&gt;i&lt;/sub&gt; × valor&lt;sub&gt;i&lt;/sub&gt; + risco&lt;sub&gt;ordem&lt;/sub&gt; × valor&lt;sub&gt;ordem&lt;/sub&gt;)&lt;br&gt;/ (Σ valor&lt;sub&gt;i&lt;/sub&gt; + valor&lt;sub&gt;ordem&lt;/sub&gt;)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="220" y="640" width="360" height="70" as="geometry" />
        </mxCell>
        <mxCell id="lim" value="&lt;b&gt;Calcular limites&lt;/b&gt;&lt;br&gt;limite_alerta = score_max × 1,10&lt;br&gt;limite_rejeicao = score_max × FATOR_REJEICAO*" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="220" y="740" width="360" height="70" as="geometry" />
        </mxCell>
        <mxCell id="note" value="* FATOR_REJEICAO não é definido no enunciado.&lt;br&gt;Valor adotado e justificado no README (configurável)." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fffbe6;strokeColor=#b3a14d;align=left;spacingLeft=6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="600" y="742" width="210" height="66" as="geometry" />
        </mxCell>
        <mxCell id="d3" value="RP &amp;gt; limite_rejeicao?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
